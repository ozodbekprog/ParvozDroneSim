# Keep this file private on the VM and copy it to deploy/backup.env.
OCI_NAMESPACE=your_object_storage_namespace
OCI_BACKUP_BUCKET=your_always_free_backup_bucket
# Authenticate as this VM after assigning a bucket-scoped dynamic-group policy.
OCI_CLI_AUTH=instance_principal
OCI_CLI_REGION=me-riyadh-1
# Stay below the 10 GB Standard allowance during Free Trial; lower for other buckets.
BACKUP_MAX_BYTES=9000000000
