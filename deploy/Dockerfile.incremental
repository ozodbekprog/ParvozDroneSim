ARG BASE_IMAGE
FROM ${BASE_IMAGE}
ARG SOURCE_COMMIT
ARG SHARED_ASSETS=0
LABEL org.opencontainers.image.revision=${SOURCE_COMMIT}
LABEL org.parvoz.shared-assets=${SHARED_ASSETS}
WORKDIR /app
COPY package*.json ./
COPY server ./server
COPY shared ./shared
COPY tools ./tools
COPY dist ./dist
COPY public ./public
USER node
